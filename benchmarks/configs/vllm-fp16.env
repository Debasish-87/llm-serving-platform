# Benchmark configuration: vllm-fp16
# Baseline configuration — matches the default deployment in k8s/serving/deployment.yaml

CONFIG_NAME=vllm-fp16
MODEL=Qwen/Qwen2.5-0.5B-Instruct
DTYPE=float16
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=1024
MAX_NUM_SEQS=2

# Load profile — must match benchmarks/k6/benchmark-test.js stage targets
CONCURRENCY_STEPS=1,2,4,8
STEP_DURATION=60s

# Hardware this config is expected to run on (edit to match actual run)
GPU_MODEL=NVIDIA GTX 1650
GPU_VRAM_GB=4

# Used by the cost model in reports/cost-latency-tradeoff.md.
# Set this to the hourly cost of the GPU instance actually used for the run
# (0 for local/owned hardware — cost-per-token becomes informational only).
GPU_COST_PER_HOUR_USD=0.00
