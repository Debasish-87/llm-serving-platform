# Benchmark configuration: vllm-awq
# Same model, quantized to 4-bit AWQ — see scripts/quantize_model.py to produce it.

CONFIG_NAME=vllm-awq
MODEL=Qwen/Qwen2.5-0.5B-Instruct-AWQ
QUANTIZATION=awq
DTYPE=auto
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=1024

# AWQ's lower memory footprint is the variable being tested — raise
# MAX_NUM_SEQS here relative to vllm-fp16.env and see whether the freed
# KV-cache headroom actually turns into higher throughput.
MAX_NUM_SEQS=4

CONCURRENCY_STEPS=1,2,4,8
STEP_DURATION=60s

GPU_MODEL=NVIDIA GTX 1650
GPU_VRAM_GB=4

GPU_COST_PER_HOUR_USD=0.00
